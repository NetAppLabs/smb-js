{
  "compilerOptions": {
    "target": "esnext",
    "strict": true,
    "strictPropertyInitialization": false,
    "moduleResolution": "node",
    "module": "CommonJS",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "lib": ["ESNext", "WebWorker"],
  },
  "include": ["./index.ts"],
  "exclude": ["node_modules"]
}
